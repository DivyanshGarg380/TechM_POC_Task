pipeline {
    agent any

    environment {
        IMAGE_NAME = "ems-frontend"
        CONTAINER_NAME = "employee-frontend"
        NETWORK_NAME = "ems-network"
        APP_PORT = "4200"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/DivyanshGarg380/TechM_POC_Task.git'
            }
        }

        stage('Build Angular App & Docker Image') {
            steps {
                dir('Frontend') {
                    sh 'docker build -t ${IMAGE_NAME}:latest .'
                }
            }
        }

        stage('Deploy Frontend Container') {
            steps {
                sh '''
                    docker network create ${NETWORK_NAME} || true
                    docker rm -f ${CONTAINER_NAME} || true
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        --network ${NETWORK_NAME} \
                        -p ${APP_PORT}:80 \
                        ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Verify Running Container') {
            steps {
                sh 'docker ps --filter "name=${CONTAINER_NAME}"'
            }
        }
    }

    post {
        success {
            echo 'Frontend deployed successfully!'
            echo 'App: http://localhost:4200'
        }
        failure {
            echo 'Frontend pipeline failed. Check the console output.'
        }
    }
}